{
  "name": "@crafyholding/crafy-captcha-js",
  "version": "1.1.5",
  "description": "Vanilla JS Client SDK for CrafyCAPTCHA",
  "main": "dist/CrafyCAPTCHA.cjs",
  "module": "dist/CrafyCAPTCHA.mjs",
  "browser": "dist/CrafyCAPTCHA.min.js",
  "exports": {
    ".": {
      "import": "./dist/CrafyCAPTCHA.mjs",
      "require": "./dist/CrafyCAPTCHA.cjs",
      "default": "./dist/CrafyCAPTCHA.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rimraf dist",
    "build:cjs": "esbuild src/CrafyCAPTCHA.js --bundle --minify --outfile=dist/CrafyCAPTCHA.cjs --format=cjs",
    "build:esm": "esbuild src/CrafyCAPTCHA.js --bundle --minify --outfile=dist/CrafyCAPTCHA.mjs --format=esm",
    "build:iife": "esbuild src/CrafyCAPTCHA.js --bundle --minify --outfile=dist/CrafyCAPTCHA.min.js --format=iife",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:iife"
  },
  "keywords": [
    "captcha",
    "crafy",
    "security",
    "bot-protection"
  ],
  "author": "CrafyCAPTCHA <hello@captcha.crafy.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crafycaptcha/crafy-captcha-js.git"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3"
  }
}
